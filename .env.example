# =============================================================================
# PNG Coffee — Next.js environment variables
# Copy this file to .env.local for local dev. Never commit .env.local.
# =============================================================================

# Base URL of the Strapi CMS API (no trailing slash).
# Local dev:   http://localhost:1337
# Production:  https://cms.pngcoffee.com
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Optional: a Strapi API token (Settings -> API Tokens -> Create, "Read-only"
# type) for server-side requests. Not required for the public content types
# (Homepage, Products, Blog, etc. are readable without auth — see the CMS
# bootstrap script), but useful if you later lock content down further or
# add preview/draft-mode fetching.
STRAPI_API_TOKEN=

# Secret used to authenticate Next.js's on-demand revalidation endpoint
# (see src/app/api/revalidate/route.ts). Set the same value as a webhook
# header/query param in Strapi's "webhooks" settings so content edits can
# invalidate the Next.js cache immediately instead of waiting for the
# default revalidation window.
REVALIDATE_SECRET=change-me
