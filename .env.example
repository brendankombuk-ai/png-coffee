# =============================================================================
# PNG Coffee — Next.js environment variables
# Copy this file to .env.local for local dev. Never commit .env.local.
# =============================================================================

# --- Google Maps ---
# Used for the custom map marker on the Contact page.
# Create a key at https://console.cloud.google.com -> APIs & Services -> Credentials
# Enable the "Maps JavaScript API" for this key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Sanity CMS ---
# Create a project at https://sanity.io/manage, then fill in the values below.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: a read/write API token (Project -> API -> Tokens -> Add API token).
# Not required for public datasets. Needed to query drafts or trigger webhooks.
SANITY_API_TOKEN=

# Secret used to verify the Sanity webhook that triggers cache revalidation.
SANITY_WEBHOOK_SECRET=change-me

# --- Payments (PayPal) ---
# Get these from https://developer.paypal.com -> Apps & Credentials.
# Create a Sandbox app for testing, and a Live app for real payments.
# NEXT_PUBLIC_PAYPAL_CLIENT_ID and PAYPAL_CLIENT_ID hold the SAME Client ID.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# "sandbox" while testing, "live" for real payments.
PAYPAL_ENV=sandbox

# --- Email (Resend) ---
# Sign up free at https://resend.com -> API Keys -> Create API Key
# On the free plan, the "from" address must be onboarding@resend.dev unless you verify a custom domain.
RESEND_API_KEY=your_resend_api_key_here
