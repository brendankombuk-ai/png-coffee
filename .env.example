# =============================================================================
# PNG Coffee — Next.js environment variables
# Copy this file to .env.local for local dev. Never commit .env.local.
# =============================================================================

# Base URL of the Strapi CMS API (no trailing slash).
# Local dev:   http://localhost:1337
# Production:  https://cms.pngcoffee.com
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Optional: a Strapi API token (Settings -> API Tokens -> Create, "Read-only"
# type) for server-side requests. Not required for the public content types
# (Homepage, Products, Blog, etc. are readable without auth — see the CMS
# bootstrap script), but useful if you later lock content down further or
# add preview/draft-mode fetching.
STRAPI_API_TOKEN=

# Secret to authenticate an on-demand revalidation endpoint, for instant
# cache invalidation when content is published in Strapi. Not built yet —
# this project currently relies on the 60-second cache window in
# src/lib/cms/client.ts instead. Set this now if you'd like that endpoint
# added later; otherwise ignore it.
REVALIDATE_SECRET=change-me

# --- Payments (Stripe) ---
# Dashboard -> Developers -> API keys (use test mode keys while building).
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
# Only needed once you've set up the webhook (see src/app/api/stripe/webhook).
STRIPE_WEBHOOK_SECRET=whsec_...

# ISO 4217 currency code for prices and Stripe Checkout. Defaults to USD.
# Stripe's SDK recognizes "PGK" (Papua New Guinea Kina), but whether YOUR
# Stripe account can actually settle in it depends on which country the
# account is registered under (Stripe has no PNG-based merchant accounts).
# Test a PGK Checkout Session in Stripe test mode before switching; fall
# back to USD or AUD if it's rejected.
NEXT_PUBLIC_CURRENCY=USD
